{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirsad",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{"binding":"DB","database_name":"mirsad-db","database_id":"3629588e-411d-49ba-97e8-32b7e2d82e4e","migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"mirsad-documents"}],
  "observability": {"enabled":true}
}
